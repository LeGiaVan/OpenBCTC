# ── 1. LLM Configuration (Text & Chat Models) ─────────────────────────
# Môi trường dev dùng Groq hoặc Gemini (miễn phí, tốc độ cao)
LLM_PROVIDER=groq

# Groq API (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# OpenAI API (Tùy chọn)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API (Tùy chọn)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Tham số sinh lời LLM (0.0 đảm bảo tính deterministic cho tài chính)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── 2. Block Classifier & Parser Settings ─────────────────────────────
# Ngưỡng tin cậy tối thiểu cho rule-based heuristic trước khi fallback LLM
RULE_CONFIDENCE_THRESHOLD=0.75
HIGH_NUMERIC_DENSITY_THRESHOLD=0.40
MIN_TABLE_ROWS_FOR_STATEMENT=3
MAX_TEXT_BLOCK_CHARS=2500

# ── 3. Vision OCR API (Cloud Vision LLM cho BCTC Cốt Lõi) ─────────────
ENABLE_OCR_FALLBACK=true
# Nhà cung cấp OCR: "auto" | "gemini" | "groq"
OCR_PROVIDER=auto
GEMINI_VISION_MODEL=gemini-flash-latest
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
OCR_RESOLUTION=150
OCR_MIN_CHAR_THRESHOLD=50

# ── 4. Offline Local OCR (VietOCR + DBNet cho Thuyết Minh & RAG) ──────
LOCAL_OCR_ENGINE=auto
LOCAL_OCR_MODEL=vgg_seq2seq
# Thiết bị chạy OCR: "auto" (ưu tiên CUDA nếu có) | "cuda" | "cpu"
LOCAL_OCR_DEVICE=auto
LOCAL_OCR_RESOLUTION=150
LOCAL_OCR_USE_CACHE=true

# ── 5. Agentic Vision-LLM Zoom Corrector (Tự Sửa Sai Cục Bộ) ──────────
ZOOM_MAX_RETRIES=2
ZOOM_CONFIDENCE_THRESHOLD=0.70
ZOOM_PADDING_PX=15
ZOOM_CROP_DPI=200

# ── 6. Accounting Verifier (Anti-GIGO Invariants) ─────────────────────
ACCOUNTING_TOLERANCE_RATIO=0.0001
ACCOUNTING_ABSOLUTE_TOLERANCE=2.0

# ── 7. Storage & Database Paths ───────────────────────────────────────
DEFAULT_DB_PATH=data/finaudit.db
DEFAULT_CACHE_DIR=data/cache
DEFAULT_OUTPUT_DIR=outputs

# ── 8. LangSmith / LLMOps Observability ───────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=FinAudit_AI
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── 9. Môi trường & Logging ───────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
